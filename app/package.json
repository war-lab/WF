{
  "name": "word-farm-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/protocol",
    "packages/worker",
    "packages/client"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @word-farm/client",
    "dev:client": "npm run dev -w @word-farm/client",
    "dev": "npm run build && npm run dev -w @word-farm/worker",
    "deploy": "npm run build && npm run deploy -w @word-farm/worker",
    "check:board": "python ../sim/export_board.py --check",
    "compare": "npm run compare -w @word-farm/engine"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
